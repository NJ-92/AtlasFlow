# Copy this file to `.env` and fill in real values before any non-local deployment.
# docker-compose.yml reads these automatically.

# --- Postgres ---
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- MinIO (data lake) ---
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-to-a-strong-password

# --- AtlasFlow API security ---
# Signs auth tokens (JWTs). Rotating this instantly invalidates every active session.
# Generate one with: openssl rand -hex 32
ATLASFLOW_JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Encrypts the secrets store at rest (Fernet key - must be 32 url-safe base64 bytes).
# Generate one with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a random key is generated on each container start - encrypted secrets
# written before a restart become unreadable. Always set this explicitly outside of
# a first local test run.
ATLASFLOW_ENCRYPTION_KEY=

# Password for the auto-created 'admin' user on first boot. Change this, then change
# the password again via the UI/API and consider deleting this env var.
ATLASFLOW_ADMIN_BOOTSTRAP_PASSWORD=change-me

# Comma-separated list of origins allowed to call the API (no trailing slashes).
ATLASFLOW_CORS_ORIGINS=http://localhost:3000

# How long an issued login token stays valid, in minutes.
ATLASFLOW_JWT_EXPIRE_MINUTES=480

# --- OIDC SSO (optional) ---
# Leave all four blank/unset to keep SSO disabled and use local username/password login only.
# Works with any standard OIDC provider: Okta, Azure AD/Entra ID, Google Workspace, Auth0, etc.
ATLASFLOW_OIDC_ISSUER=
ATLASFLOW_OIDC_CLIENT_ID=
ATLASFLOW_OIDC_CLIENT_SECRET=
ATLASFLOW_OIDC_REDIRECT_URI=http://localhost:8000/api/auth/sso/callback
# Where to send the browser back to after a successful SSO login.
ATLASFLOW_FRONTEND_URL=http://localhost:3000

# --- compute cost estimation (usage estimate only - this is self-hosted, not billed) ---
ATLASFLOW_COST_PER_WORKER_HOUR=0.40

# --- SAML SSO (optional, alongside OIDC above) ---
# Written correctly against the SAML 2.0 spec but not tested against a live IdP in this
# environment - test against yours (Okta, Azure AD, etc.) before relying on it.
ATLASFLOW_SAML_IDP_ENTITY_ID=
ATLASFLOW_SAML_IDP_SSO_URL=
ATLASFLOW_SAML_IDP_X509_CERT=
ATLASFLOW_SAML_BASE_URL=http://localhost:8000

# --- SCIM user provisioning (optional) ---
# Set to a random secret and give the same value to your IdP as the SCIM bearer token.
# Generate one with: openssl rand -hex 32
# IdP SCIM base URL: http://<your-host>:8000/scim/v2
ATLASFLOW_SCIM_TOKEN=

# --- Stripe metered billing (optional) ---
# Real payment collection - see backend/app/billing.py for setup details (you configure
# the Price in your own Stripe Dashboard first). Test in Stripe test mode before going live.
ATLASFLOW_STRIPE_SECRET_KEY=
ATLASFLOW_STRIPE_PRICE_ID=
ATLASFLOW_STRIPE_WEBHOOK_SECRET=

# --- autoscaler (optional) ---
# Automatically adds/removes Spark worker containers based on load. Requires the
# docker.sock mount in docker-compose.yml, which gives the backend container control over
# the whole Docker host - only enable on infrastructure you trust that much. See
# SECURITY.md and backend/app/autoscaler.py before turning this on.
ATLASFLOW_AUTOSCALE_ENABLED=false
ATLASFLOW_AUTOSCALE_MIN_WORKERS=0
ATLASFLOW_AUTOSCALE_MAX_EXTRA_WORKERS=4
ATLASFLOW_AUTOSCALE_POLL_SECONDS=20

# --- Genie AI agent (optional) ---
# Real integration with the Anthropic API - natural language questions get turned into
# SQL and run against your catalog tables. Requires your own API key from
# https://console.anthropic.com. If unset, the Genie tab is simply hidden.
ATLASFLOW_ANTHROPIC_API_KEY=
ATLASFLOW_GENIE_MODEL=claude-sonnet-4-5
